+def test_forward_avisa_con_migracion_pendiente():
+    """PER-LOG-006: widen_gpt/deepen_gpt dejan migracion pendiente; un forward
+    de ENTRENAMIENTO (gradiente habilitado) debe avisar con RuntimeWarning en
+    vez de entrenar en silencio con un optimizer que ya no referencia los
+    parametros vivos. rel_drift y las sondas corren bajo no_grad y no deben
+    avisar; tampoco tras migrate_optimizer ni dentro de un apply_event
+    aceptado."""
+    model, opt, x = model_and_opt()
+
+    def pendientes(record):
+        return [
+            w
+            for w in record
+            if issubclass(w.category, RuntimeWarning) and "migracion de optimizer pendiente" in str(w.message)
+        ]
+
+    def assert_sin_aviso(fn):
+        with warnings.catch_warnings(record=True) as record:
+            warnings.simplefilter("always")
+            result = fn()
+        assert pendientes(record) == []
+        return result
+
+    recs = shape.widen_gpt(model, 12)
+    with pytest.warns(RuntimeWarning, match="migracion de optimizer pendiente"):
+        model(x)
+    with torch.no_grad():
+        assert_sin_aviso(lambda: model(x))
+    opt = shape.migrate_optimizer(model, opt, recs)
+    assert_sin_aviso(lambda: model(x))  # migrado: no debe avisar
+
+    shape.deepen_gpt(model, 1)
+    with pytest.warns(RuntimeWarning, match="migracion de optimizer pendiente"):
+        model(x)
+    with torch.no_grad():
+        assert_sin_aviso(lambda: model(x))
+    opt = shape.migrate_optimizer(model, opt, [])
+    assert_sin_aviso(lambda: model(x))  # migrado: no debe avisar
+
+    _, report = assert_sin_aviso(
+        lambda: shape.apply_event(model, opt, shape.GrowthEvent(1, new_d=16, add_layers=1), probe_x=x)
+    )
+    assert report["accepted"] is True

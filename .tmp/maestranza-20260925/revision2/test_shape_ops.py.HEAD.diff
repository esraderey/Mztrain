+def test_ancla_PER_API_004():
+    """PER-API-004: pad_state_tensor debe rechazar new_shape que no sea una
+    secuencia de int de Python (p.ej. un tensor) con ValueError explicito."""
+    t = torch.randn(4)
+    with pytest.raises(ValueError):
